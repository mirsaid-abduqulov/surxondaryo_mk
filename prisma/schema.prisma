generator client {
  provider = "prisma-client-js"
  output   = "../src/core/database/generated"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// FOYDALANUVCHI (ADMIN PANEL)
// ==========================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id                   String    @id @default(uuid())
  phone_number         String    @unique
  email                String?   @unique
  full_name            String
  hashed_password      String
  hashed_refresh_token String?
  refresh_token_jti    String?
  role                 UserRole  @default(EDITOR)
  is_login             Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  announcements Announcement[]
  news          News[]
  events        Event[]
  documents     Document[]
  media_albums  MediaAlbum[]
  staff_members StaffMember[]
  clubs         Club[]
  newspapers    Newspaper[]
}

// ==========================================================
// MAKTAB TASHRIF QOG'OZI / RAHBARIYAT VA O'QITUVCHILAR
// ==========================================================

enum StaffCategory {
  DIRECTOR              // direktor
  DEPUTY_DIRECTOR       // direktor o'rinbosari
  TEACHER               // o'qituvchi
  ADMINISTRATION        // ma'muriyat xodimi
  OTHER
}

model StaffMember {
  id              String        @id @default(uuid())
  full_name_latin String
  full_name_cyril String
  full_name_ru    String
  category        StaffCategory

  position_latin  String
  position_cyril  String
  position_ru     String

  // o'qituvchilar uchun fan yo'nalishi
  subject_latin   String?
  subject_cyril   String?
  subject_ru      String?

  bio_latin       String?
  bio_cyril       String?
  bio_ru          String?

  photo_url       String?
  phone           String?
  email           String?

  // direktor qabulxonasi uchun: qabul kunlari/soatlari
  reception_days  String?

  degree_latin    String?   // ilmiy daraja / toifa
  degree_cyril    String?
  degree_ru       String?

  order           Int       @default(0)
  is_active       Boolean   @default(true)

  creator_id      String
  creator         User      @relation(fields: [creator_id], references: [id])

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

// ==========================================================
// TO'GARAKLAR VA SEKTSIYALAR
// ==========================================================

enum ClubCategory {
  SPORT      //sport
  SCIENCE    // ilmiy
  ART        //san'at
  LANGUAGE   //til
  TECHNOLOGY //texnologiya
  MUSIC      //musiqa
  OTHER      //boshqa
}

model Club {
  id                 String       @id @default(uuid())
  name_latin         String
  name_cyril         String
  name_ru            String
  category           ClubCategory
  start_date         DateTime?
  end_date           DateTime?      // if null, then it is active

  description_latin  String?
  description_cyril  String?
  description_ru     String?

  supervisor_name    String?      // rahbar / murabbiy ismi
  age_group          String?      // masalan "5-7-sinflar"

  schedule           Json?        // { "monday": [ { "start": "08:00", "end": "09:00", "room": "101"} ] }
  location           String?
  cover_image        String?
  is_active          Boolean      @default(true)

  creator_id         String
  creator            User         @relation(fields: [creator_id], references: [id])

  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
}

// ==========================================================
// DARS VA QO'NG'IROQ JADVALLARI
// ==========================================================

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model ClassSchedule {
  id             String   @id @default(uuid())
  grade          String   // masalan "5-A", "9-B"
  day            WeekDay
  lesson_number  Int

  subject_latin  String
  subject_cyril  String
  subject_ru     String

  teacher_name   String?
  room           String?
  start_time     String   // "08:30"
  end_time       String   // "09:15"

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([grade, day])
}

model BellSchedule {
  id             String   @id @default(uuid())
  lesson_number  Int
  start_time     String
  end_time       String
  break_minutes  Int?
  shift          Int      @default(1)   // 1-smena / 2-smena
  is_active      Boolean  @default(true)

  @@unique([lesson_number, shift])
}

// ==========================================================
// BAYRAM / TA'TIL JADVALI
// ==========================================================

model HolidaySchedule {
  id             String   @id @default(uuid())
  title_latin    String
  title_cyril    String
  title_ru       String
  start_date     DateTime
  end_date       DateTime
  description_latin String?
  description_cyril String?
  description_ru    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

// ==========================================================
// OSHXONA MENYUSI
// ==========================================================



model CanteenMenu {
  id          String    @id @default(uuid())

  start_date  DateTime
  end_date    DateTime?
  is_active   Boolean   @default(false)

  monday      Json?
  tuesday     Json?
  wednesday   Json?
  thursday    Json?
  friday      Json?
  saturday    Json?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

// ==========================================================
// OTA-ONA - O'QITUVCHI UCHRASHUVLARI
// ==========================================================

model ParentTeacherMeeting {
  id                 String   @id @default(uuid())
  title_latin        String
  title_cyril        String
  title_ru           String

  description_latin  String?
  description_cyril  String?
  description_ru     String?

  grade              String?  // bo'sh bo'lsa - umumiy uchrashuv
  meeting_date       DateTime
  location           String?

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

// ==========================================================
// ONLAYN QABUL ARIZASI
// ==========================================================

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  ACCEPTED
  REJECTED
}

model AdmissionApplication {
  id                 String             @id @default(uuid())
  student_full_name  String
  birth_date         DateTime
  grade_applying     String             // qabul qilinayotgan sinf

  parent_full_name   String
  parent_phone       String
  parent_email       String?
  address            String?
  previous_school    String?
  message            String?

  status             ApplicationStatus  @default(NEW)
  admin_comment      String?

  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
}

// qabul uchun talab qilinadigan hujjatlar ro'yxati (matn ko'rinishida)
model RequiredDocument {
  id                 String  @id @default(uuid())
  title_latin        String
  title_cyril        String
  title_ru           String
  description_latin  String?
  description_cyril  String?
  description_ru     String?
  order              Int     @default(0)
  is_active          Boolean @default(true)
}

// ==========================================================
// DIREKTOR QABULXONASIGA ELEKTRON MUROJAAT
// ==========================================================

enum AppealStatus {
  NEW
  IN_PROGRESS
  ANSWERED
}

model DirectorAppeal {
  id          String       @id @default(uuid())
  full_name   String
  phone       String
  email       String?
  subject     String?
  message     String

  answer      String?
  status      AppealStatus @default(NEW)

  created_at  DateTime     @default(now())
  answered_at DateTime?
}

// ==========================================================
// YANGILIKLAR VA TADBIRLAR
// ==========================================================

model News {
  id            String   @id @default(uuid())
  title_latin   String
  title_cyril   String
  title_ru      String
  content_latin String
  content_cyril String
  content_ru    String
  cover_image   String?
  is_public     Boolean  @default(true)
  published_at  DateTime @default(now())

  creator_id    String
  creator       User     @relation(fields: [creator_id], references: [id])

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

enum EventType {
  SCHOOL_EVENT     // maktab tadbiri
  HOLIDAY          // bayram
  COMPETITION      // musobaqa/olimpiada
  OTHER
}

model Event {
  id                 String    @id @default(uuid())
  title_latin        String
  title_cyril        String
  title_ru           String
  description_latin  String?
  description_cyril  String?
  description_ru     String?
  location_latin     String?
  location_cyril     String?
  location_ru        String?
  cover_image        String?
  type               EventType @default(SCHOOL_EVENT)
  event_date         DateTime
  is_public          Boolean   @default(true)

  creator_id         String
  creator            User      @relation(fields: [creator_id], references: [id])

  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}

// e'lonlar (talabalar uchun: to'garak, sektsiya, tadbir haqida qisqa e'lon)
model Announcement {
  id            String   @id @default(uuid())
  title_latin   String
  title_cyril   String
  title_ru      String
  content_latin String
  content_cyril String
  content_ru    String
  cover_image   String?
  is_public     Boolean  @default(true)
  published_at  DateTime @default(now())

  creator_id    String
  creator       User     @relation(fields: [creator_id], references: [id])

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ==========================================================
// HUJJATLAR BO'LIMI (davlat idoralari uchun majburiy)
// ==========================================================

enum DocumentCategory {
  CHARTER            // nizom
  LICENSE            // litsenziya
  SELF_ASSESSMENT    // o'z-o'zini baholash hisoboti
  ORDER              // buyruq
  REPORT             // hisobot
  OTHER
}

model Document {
  id           String           @id @default(uuid())
  title_latin  String
  title_cyril  String
  title_ru     String
  category     DocumentCategory
  file_url     String
  file_name    String
  file_size    Int?
  published_at DateTime         @default(now())
  is_public    Boolean          @default(true)

  creator_id   String
  creator      User             @relation(fields: [creator_id], references: [id])

  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
}

// ==========================================================
// MEDIA ZONASI: FOTO/VIDEO GALEREYA
// ==========================================================

enum MediaType {
  PHOTO
  VIDEO
  PRESENTATION
}

model MediaAlbum {
  id          String      @id @default(uuid())
  title_latin String
  title_cyril String
  title_ru    String
  type        MediaType
  cover_image String?
  is_public   Boolean     @default(true)

  creator_id  String
  creator     User        @relation(fields: [creator_id], references: [id])

  items       MediaItem[]

  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
}

model MediaItem {
  id         String     @id @default(uuid())
  album_id   String
  album      MediaAlbum @relation(fields: [album_id], references: [id], onDelete: Cascade)
  url        String
  file_name  String
  file_size  Int?
  thumbnail  String?
  order      Int        @default(0)
  created_at DateTime   @default(now())
}

// maktab gazetasi (davriy PDF nashrlar)
model Newspaper {
  id            String   @id @default(uuid())
  title_latin   String
  title_cyril   String
  title_ru      String
  issue_number  Int?
  cover_image   String?
  file_url      String
  file_size     Int?
  published_at  DateTime @default(now())

  creator_id    String
  creator       User     @relation(fields: [creator_id], references: [id])

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ==========================================================
// STATIK SAHIFALAR
// ==========================================================

enum PageSlug {
  ABOUT                    // maktab tarixi, yutuqlari
  ADMISSION_REQUIREMENTS   // qabul talablari
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  FAQ
  RULES
  CONTACTS
}

model Page {
  id            String   @id @default(uuid())
  slug          PageSlug @unique
  title_latin   String
  title_cyril   String
  title_ru      String
  content_latin String
  content_cyril String
  content_ru    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ==========================================================
// BOSH SAHIFA BANNER
// ==========================================================

model Banner {
  id          String   @id @default(uuid())
  title_latin String?
  title_cyril String?
  title_ru    String?
  image_url   String
  link_url    String?
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// foydali havolalar (masalan: davlat ta'lim portallari)
model UsefulLink {
  id          String  @id @default(uuid())
  title_latin String
  title_cyril String
  title_ru    String
  url         String
  icon        String?
  order       Int     @default(0)
  is_active   Boolean @default(true)
}

// ==========================================================
// ALOQA (OTA-ONALAR / MA'MURIYAT BILAN BOG'LANISH)
// ==========================================================

model ContactInfo {
  id            String   @id @default(uuid())
  address_latin String
  address_cyril String
  address_ru    String
  phone         String
  email         String
  latitude      Float?
  longitude     Float?
  social_links  Json?
  updated_at    DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(uuid())
  full_name  String
  email      String?
  phone      String?
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}